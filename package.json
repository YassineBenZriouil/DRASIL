    "dependencies": {
        "electron-updater": "^6.8.9"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.5",
        "electron": "^44.9.0",
        "electron-builder": "^26.15.3",
        "electron-vite": "^6.0.0",
        "eslint": "^10.13.0",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.4"
